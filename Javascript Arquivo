function editarTitulo() {
    const novoTexto = prompt("Editar título:");
    if (novoTexto) {
        document.getElementById("titulo").textContent = novoTexto;
    }
}

function editarFoto() {
    const novaFoto = prompt("Cole o URL da nova imagem:");
    if (novaFoto) {
        document.getElementById("foto").src = novaFoto;
    }
}

function editarDataNascimento() {
    const novaData = prompt("Editar data de nascimento:");
    if (novaData) {
        document.getElementById("dataNascimento").textContent = novaData;
    }
}

function editarCidade() {
    const novaCidade = prompt("Editar cidade:");
    if (novaCidade) {
        document.getElementById("cidade").textContent = novaCidade;
    }
}

function incluirPassatempo() {
    const novoPassatempo = prompt("Adicionar passatempo:");
    if (novoPassatempo) {
        const lista = document.getElementById("passatempos");
   
        const itens = lista.querySelectorAll("li");
        let substituido = false;

        itens.forEach(item => {
            if (item.textContent === "__________________________" && !substituido) {
                item.textContent = novoPassatempo;
                substituido = true;
            }
        });

        
        if (!substituido) {
            const novoItem = document.createElement("li");
            novoItem.textContent = novoPassatempo;
            lista.appendChild(novoItem);
        }
    }
}

function editarPassatempos() {
    const passatempos = document.querySelectorAll("#passatempos li");
    passatempos.forEach((item, index) => {
        const novoTexto = prompt(`Editar passatempo ${index + 1}:`, item.textContent);
        if (novoTexto) {
            item.textContent = novoTexto;
        }
    });
}

function verificarCampos() {
    const titulo = document.getElementById("titulo").textContent;
    const dataNascimento = document.getElementById("dataNascimento").textContent;
    const cidade = document.getElementById("cidade").textContent;
    const passatempos = document.querySelectorAll("#passatempos li");

    if (
        titulo !== "Título do Site" &&
        dataNascimento !== "____________" &&
        cidade !== "___________________" &&
        Array.from(passatempos).every(item => item.textContent !== "__________________________")
    ) {
        document.body.innerHTML = '<img src="https://via.placeholder.com/1920x1080" alt="Imagem de confirmação" style="width: 100%; height: 100vh; object-fit: cover;">';
    } else {
        alert("Preencha todos os campos obrigatórios!");
    }
}

